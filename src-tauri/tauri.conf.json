{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyJellyfinClient",
  "version": "0.4.3",
  "identifier": "com.myjellyfinclient.app",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http: https:; media-src 'self' blob: http: https:; connect-src 'self' ipc: http://ipc.localhost http: https: ws:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "resources/mpv/*.exe": "mpv",
      "resources/mpv/*.com": "mpv",
      "resources/mpv/*.dll": "mpv",
      "resources/mpv/portable_config/scripts/mjc-osc.lua": "mpv/portable_config/scripts/mjc-osc.lua",
      "resources/mpv/portable_config/shaders/mjc-glass.glsl": "mpv/portable_config/shaders/mjc-glass.glsl",
      "resources/WebView2Loader.dll": ""
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      },
      "signCommand": {
        "cmd": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "../scripts/sign.ps1",
          "-Paths",
          "%1"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
